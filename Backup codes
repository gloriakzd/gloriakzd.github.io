/* ===== CLOSE ICON ===== */

.window-bar .close {

  background: none;

  border: none;

  font-size: .9rem;

  cursor: pointer;

  opacity: .35;

  transition: opacity .25s ease, transform .25s ease;

}



.window:hover .close {

  opacity: .55;

}



.window-bar .close:hover {

  opacity: .9;

  transform: scale(1.5);

}



/* ===== DOCK ===== */

.window-dock {

  position: fixed;

  bottom: 32px;

  right: 32px;



  display: flex;

  gap: 10px;



  z-index: 500;

  pointer-events: auto;



}





/* SCROLL REVEAL */

.reveal {

  opacity: 0;

  transform: translateY(14px);

  transition:

    opacity .6s cubic-bezier(.2, .8, .2, 1),

    transform .6s cubic-bezier(.2, .8, .2, 1);

}



.reveal.show {

  opacity: 1;

  transform: translateY(0);

}







/* ==============================

FINDER FILE SYSTEM

============================== */



/* This forces the two-column side-by-side layout */
.work-layout {
  display: flex;
  /* Uses Flexbox to put items side-by-side */
  gap: 20px;
  height: 100%;
  align-items: stretch;
}



/* file grid */
/* The Left Side (The Files) */
.file-grid {
  flex: 1;
  /* Takes up the remaining space */
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 1.5rem;
  align-content: start;
}



/* file item */

.file-item {

  cursor: pointer;

  text-align: center;

  padding: .6rem;

  border-radius: 12px;

  transition:

    transform .22s ease,

    background .22s ease,

    box-shadow .22s ease;

}



.file-item:hover {

  background: rgba(0, 0, 0, .04);

  transform: translateY(-4px);

}



/* thumbnail */

.file-thumb {

  height: 80px;

  border-radius: 10px;

  overflow: hidden;

  background: #eee;

  margin-bottom: .45rem;

}



.file-thumb img {

  width: 100%;

  height: 100%;

  object-fit: cover;

}



/* filename */

.file-name {

  font-size: .65rem;

  letter-spacing: .05em;

  opacity: .7;

}





/* ==============================

PREVIEW PANEL

============================== */


/* The Right Side (The Preview Sidebar) */
.preview-panel {
  width: 260px;
  /* Fixed width like a real Mac sidebar */
  border-left: 1px solid rgba(0, 0, 0, 0.08);
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}



.preview-media {

  height: 120px;

  border-radius: 12px;

  overflow: hidden;

  background: #ddd;

}



.preview-media img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  opacity: 0;

  transition: opacity .25s ease;

}



.preview-media img.loaded {

  opacity: 1;

}



.preview-title {

  font-size: .9rem;

  margin: 0;

}



.preview-desc {

  font-size: .75rem;


  max-width: 28ch;

  opacity: .8;

}











.profile-photo {

  width: 100%;

  max-width: 300px;

  border-radius: 18px;

  overflow: hidden;

  box-shadow:

    0 20px 40px rgba(0, 0, 0, .08),

    inset 0 1px rgba(255, 255, 255, .6);

}



.profile-photo img {

  width: 100%;

  display: block;

  object-fit: cover;

}



.about-title {

  font-size: 3rem;

  line-height: 1.05;

  letter-spacing: -0.02em;

  margin: 0 0 .6rem;

}



.about-tag {

  font-size: 1.1rem;


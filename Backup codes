/* Apply this to your workspace windows (the ones that hold the files) */

.window.workspace {

  transition:

    filter 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),

    transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),

    opacity 0.6s ease;

}



/* This is the state triggered by your JavaScript */

.window.workspace.dimmed {

  filter: blur(8px) brightness(0.9) saturate(0.8);

  transform: scale(0.96);

  /* Subtle push-back effect */

  pointer-events: none;

  /* Prevents clicking files while a project is open */

  opacity: 0.7;

  /* Optional: makes the background feel recessed */

}





/* The invisible clickable area over dimmed windows */

.workspace-overlay {

  position: absolute;

  inset: 0;

  /* covers the whole window */

  z-index: 10;

  /* sits above the files, but below the project window */

  cursor: zoom-out;

  display: none;

}



/* Show it only when the workspace is dimmed */

.workspace.dimmed .workspace-overlay {

  display: block;

}






  /* Border & Radius */
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.4);

  /* The "Luminous" Bloom Shadow */
  box-shadow:
    0 40px 100px rgba(0, 0, 0, 0.15),
    0 10px 30px rgba(244, 232, 224, 0.4);

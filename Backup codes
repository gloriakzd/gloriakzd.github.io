<!-- ==============================
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f5f1ee;
  font-family: serif;
  color: #2b2b2b;
}


/* ===== DESK ===== */
.desk {
  position: relative;
  max-width: 1200px;
  margin-left: 8vw;
  padding-top: 10rem;
}



/* ===== CARD STACK ===== */
.card-stack {
  position: relative;
  height: 260px;
  z-index: 2;
  transition: transform .35s cubic-bezier(.2, .8, .2, 1);
}



.card-cta {
  position: absolute;
  top: 16px;
  right: 20px;
  font-size: .7rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  opacity: .75;
  pointer-events: none;
}


.back-card {
  position: absolute;
  overflow: hidden;
  /* important */
  left: 50%;
  transform: translateX(-50%);
  width: 620px;
  height: 220px;
  border-radius: 16px;
  cursor: pointer;
  text-decoration: none;
  color: inherit;

  /* ⭐ REAL DEPTH */
  box-shadow:
    0 18px 35px rgba(0, 0, 0, .08),
    /* outer shadow */
    0 2px 0 rgba(255, 255, 255, .45) inset,
    /* top highlight */
    0 -1px 0 rgba(0, 0, 0, .05) inset;
  /* bottom edge */
  transition:
    transform .35s cubic-bezier(.2, .8, .2, 1),
    box-shadow .35s ease,
    filter .35s ease;
  overflow: hidden;
}


.card-one {

  background: #e8dcd5;

  top: 0;

}



.card-two {

  background: #dfe7e3;

  top: 32px;

}



.card-three {

  background: #e6e1f0;

  top: 64px;

}



.back-card::after {

  content: "";

  position: absolute;

  top: -50%;

  left: -120%;

  width: 60%;

  height: 200%;



  background: linear-gradient(120deg,

      transparent,

      rgba(255, 255, 255, .35),

      transparent);



  transform: skewX(-20deg);

  transition: left 2.2s cubic-bezier(.2, .8, .2, 1);

}



.back-card:hover {

  transform: translateX(-50%) translateY(-12px) scale(1.01);

  box-shadow:

    0 26px 50px rgba(0, 0, 0, .12),

    0 2px 0 rgba(255, 255, 255, .45) inset,

    0 -1px 0 rgba(0, 0, 0, .05) inset;

}



.back-card:hover::after {

  left: 140%;

  transition-delay: .12s;

}







/* ===== FOLDER (now above cards) ===== */

.folder {

  position: relative;

  width: 900px;

  margin: -160px auto 0;

  z-index: 5;



  transform: translateY(0);

  transition:

    transform .45s cubic-bezier(.2, .8, .2, 1),

    filter .45s ease;

}



/* one window open */

.folder--active {

  transform: translateY(10px);

  filter: brightness(.96);

}



/* two windows open */

.folder--busy {

  transform: translateY(18px);

  filter: brightness(.92);

}







.folder-image {

  width: 100%;

  height: 380px;

  border-radius: 20px;

  display: block;

}



.folder-content {

  position: absolute;

  inset: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  pointer-events: none;

}







.resize-handle {

  position: absolute;

  right: 0;

  bottom: 0;

  width: 20px;

  height: 20px;

  cursor: nwse-resize;

  background: linear-gradient(135deg, transparent 50%, rgba(0, 0, 0, 0.1) 50%);

  border-radius: 0 0 18px 0;

}





/* ===== WINDOWS ===== */

.window {

  position: fixed;

  top: 8vh;

  left: 50%;

  transform: translateX(-50%);

  width: min(900px, 90vw);

  height: min(70vh, 700px);

  background: #f8f5f2;

  border-radius: 18px;

  box-shadow: 0 30px 70px rgba(0, 0, 0, .2);

  display: none;

  z-index: 50;

}





.window.preview {

  width: min(580px, 40vw);
  /* This ensures they never take up more than 40% of the screen */

  height: min(420px, 52vh);

}



.window-bar {

  display: flex;

  align-items: center;

  padding: .75rem 1rem;

  font-size: .75rem;

  letter-spacing: .08em;

  text-transform: uppercase;

  opacity: .7;

  border-bottom: 1px solid rgba(0, 0, 0, .08);

}



.window-mode {

  margin-left: auto;

  margin-right: .75rem;

  font-size: .65rem;

}



.window-body {

  padding: 2rem;

  height: calc(100% - 48px);

  overflow-y: auto;

  display: block;
  /* Ensures it behaves as a container */

  position: relative;

  max-width: 640px;

  margin: 0 auto;

}





.dock-item {

  padding: .45rem .8rem;



  font-size: .68rem;

  letter-spacing: .08em;

  text-transform: uppercase;



  border-radius: 999px;



  background: rgba(248, 245, 242, .75);

  backdrop-filter: blur(6px);



  box-shadow:

    0 6px 14px rgba(0, 0, 0, .08),

    inset 0 1px rgba(255, 255, 255, .7);



  color: #5a5754;



  cursor: pointer;



  transition:

    transform .28s cubic-bezier(.2, .8, .2, 1),

    box-shadow .28s ease,

    background .28s ease;

}





/* ===== ABOUT LAYOUT ===== */



.about-layout h4 {

  margin-top: 1.6rem;

  font-size: .75rem;

  letter-spacing: .08em;

  text-transform: uppercase;

  opacity: .6;

}



.about-hero {

  display: grid;

  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

  gap: 2rem;

  align-items: center;

  margin-bottom: 4rem;

}



.about-title {

  font-size: 3rem;


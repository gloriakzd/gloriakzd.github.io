.floating-window {
  display: none;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);

  /* Size Proportions */
  width: min(600px, 90vw);
  max-height: 85vh;

  /* Glassmorphism Vibe */
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(25px) saturate(180%);

/* ===== MISSING INTERACTION CLASSES ===== */



/* subtle depth shift for card stack when windows open */

.card-stack.depth-shift {

  transform: translateY(-12px) scale(0.992);

}



/* quick focus pulse for windows */

.focus-pulse {

  animation: focusPulse .26s cubic-bezier(.2, .8, .2, 1) both;

}



@keyframes focusPulse {

  0% {

    transform: scale(1) translateY(0);

  }



  50% {

    transform: scale(1.02) translateY(-6px);

  }



  100% {

    transform: scale(1) translateY(0);

  }

}



/* folder wiggle used briefly on load */

.wiggle {

  animation: wiggle .6s ease both;

}



@keyframes wiggle {

  0% {

    transform: rotate(0deg);

  }



  25% {

    transform: rotate(-2deg);

  }



  75% {

    transform: rotate(1.2deg);

  }



  100% {

    transform: rotate(0deg);

  }

}



/* gentle breathe animation for folder when windows change */

.folder-breathe {

  animation: breathe 1s ease-in-out both;

}



@keyframes breathe {

  0% {

    transform: translateY(0);

  }



  50% {

    transform: translateY(-8px);

  }



  100% {

    transform: translateY(0);

  }

}



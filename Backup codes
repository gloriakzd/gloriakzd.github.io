/* ===== INVISIBLE SCROLL ===== */



/* Crucial: Keeps everything contained inside the window */
.window-body {
  padding: 1.5rem;
  height: calc(100% - 48px);

  /* Prevents the whole window from scrolling */
}



/* Chrome / Safari / Edge */

.window-body::-webkit-scrollbar {

  width: 0;

  height: 0;

